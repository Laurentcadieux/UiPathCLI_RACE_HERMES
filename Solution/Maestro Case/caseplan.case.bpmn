      <bpmn:sequenceFlow id="edge_CaseCyclePrepareNode-CaseRulesEvaluatorNode" sourceRef="CaseCyclePrepareNode" targetRef="CaseRulesEvaluatorNode" />
      <bpmn:sequenceFlow id="edge_CaseRulesEvaluatorNode-CaseManagerNode" sourceRef="CaseRulesEvaluatorNode" targetRef="CaseManagerNode" />
      <bpmn:sequenceFlow id="edge_CaseManagerNode-Activity_Guardrails" sourceRef="CaseManagerNode" targetRef="Activity_Guardrails" />
      <bpmn:sequenceFlow id="edge_Activity_Guardrails-CaseCycleCommitNode" sourceRef="Activity_Guardrails" targetRef="CaseCycleCommitNode" />
      <bpmn:sequenceFlow id="edge_CaseCycleCommitNode-checkEndCaseGatewayNode" sourceRef="CaseCycleCommitNode" targetRef="checkEndCaseGatewayNode" />
      <bpmn:sequenceFlow id="edge_checkEndCaseGatewayNode-SendCaseEndMessageEvent" sourceRef="checkEndCaseGatewayNode" targetRef="SendCaseEndMessageEvent">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:(vars.caseManagerDecisions != null &amp;&amp; vars.caseManagerDecisions.caseResolution != null &amp;&amp; vars.caseManagerDecisions.caseResolution.type != null) ? vars.caseManagerDecisions.caseResolution.type == "completed" : false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="edge_checkEndCaseGatewayNode-eventSubprocessSLAParallelGateway" sourceRef="checkEndCaseGatewayNode" targetRef="eventSubprocessSLAParallelGateway" />
      <bpmn:sequenceFlow id="edge_eventSubprocessSLAParallelGateway-eventSubprocessSLAInclusiveGateway" sourceRef="eventSubprocessSLAParallelGateway" targetRef="eventSubprocessSLAInclusiveGateway" />
      <bpmn:sequenceFlow id="edge_eventSubprocessSLAParallelGateway-loopExclusiveGateway" sourceRef="eventSubprocessSLAParallelGateway" targetRef="loopExclusiveGateway" />
      <bpmn:sequenceFlow id="edge_eventSubprocessSLAParallelGateway-eventSubprocessExclusiveGateway" sourceRef="eventSubprocessSLAParallelGateway" targetRef="eventSubprocessExclusiveGateway" />
      <bpmn:sequenceFlow id="edge_eventSubprocessSLAInclusiveGateway-eventSubprocessStagesExitedInclusiveGateway" sourceRef="eventSubprocessSLAInclusiveGateway" targetRef="eventSubprocessStagesExitedInclusiveGateway">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:(vars.caseManagerDecisions != null &amp;&amp; ((vars.caseManagerDecisions.stagesExited != null &amp;&amp; vars.caseManagerDecisions.stagesExited.length &gt; 0) || (vars.caseManagerDecisions.stagesCompleted != null &amp;&amp; vars.caseManagerDecisions.stagesCompleted.length &gt; 0)))</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="edge_eventSubprocessSLAInclusiveGateway-eventSubprocessStagesEnteredInclusiveGateway" sourceRef="eventSubprocessSLAInclusiveGateway" targetRef="eventSubprocessStagesEnteredInclusiveGateway">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:(vars.caseManagerDecisions != null &amp;&amp; vars.caseManagerDecisions.stagesEntered != null &amp;&amp; vars.caseManagerDecisions.stagesEntered.length &gt; 0)</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="edge_eventSubprocessSLAInclusiveGateway-eventSubprocessNoStagesToEnterExitInclusiveGateway" sourceRef="eventSubprocessSLAInclusiveGateway" targetRef="eventSubprocessNoStagesToEnterExitInclusiveGateway">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:(vars.caseManagerDecisions == null || ((vars.caseManagerDecisions.stagesEntered == null || vars.caseManagerDecisions.stagesEntered.length == 0) &amp;&amp; (vars.caseManagerDecisions.stagesExited == null || vars.caseManagerDecisions.stagesExited.length == 0) &amp;&amp; (vars.caseManagerDecisions.stagesCompleted == null || vars.caseManagerDecisions.stagesCompleted.length == 0)))</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="edge_eventSubprocessStagesExitedInclusiveGateway-stopStageSlaMessageEvent_stage_1" sourceRef="eventSubprocessStagesExitedInclusiveGateway" targetRef="stopStageSlaMessageEvent_stage_1">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:((vars.caseManagerDecisions.stagesExited != null &amp;&amp; vars.caseManagerDecisions.stagesExited.length &gt; 0 &amp;&amp; vars.caseManagerDecisions.stagesExited.some((stage) =&gt; stage.stageName == 'Stage 1')) || (vars.caseManagerDecisions.stagesCompleted != null &amp;&amp; vars.caseManagerDecisions.stagesCompleted.length &gt; 0 &amp;&amp; vars.caseManagerDecisions.stagesCompleted.some((stage) =&gt; stage.stageName == 'Stage 1')))</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="edge_eventSubprocessStagesExitedInclusiveGateway-eventSubprocessNoValidStagesToExitEndEvent" sourceRef="eventSubprocessStagesExitedInclusiveGateway" targetRef="eventSubprocessNoValidStagesToExitEndEvent">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:(vars.caseManagerDecisions.stagesExited == null || vars.caseManagerDecisions.stagesExited.length == 0 || !vars.caseManagerDecisions.stagesExited.some((stage) =&gt; stage.stageName == 'Stage 1')) &amp;&amp; (vars.caseManagerDecisions.stagesCompleted == null || vars.caseManagerDecisions.stagesCompleted.length == 0 || !vars.caseManagerDecisions.stagesCompleted.some((stage) =&gt; stage.stageName == 'Stage 1'))</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="edge_loopExclusiveGateway-endCancelTaskLoopNode" sourceRef="loopExclusiveGateway" targetRef="endCancelTaskLoopNode">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:(vars.caseManagerDecisions == null || vars.caseManagerDecisions.tasksToCancel == null || vars.caseManagerDecisions.tasksToCancel.length == 0)</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="edge_loopExclusiveGateway-CancelTasksHandlerNode" sourceRef="loopExclusiveGateway" targetRef="CancelTasksHandlerNode" />
